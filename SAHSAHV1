:root{
  --bg:#0e0b14;           /* koyu morimsi siyah */
  --royal:#2E004F;        /* derin mor */
  --gold:#E0B341;         /* altın */
  --text:#e9e6f2;
  --muted:#ab9ec0;
  --glass:rgba(255,255,255,.08);
  --border:rgba(255,255,255,.12);
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;
  color:var(--text); background: radial-gradient(1000px 600px at 20% -10%, #3b145f33, transparent),
                      radial-gradient(800px 600px at 90% 10%, #6a34b233, transparent),
                      var(--bg);
}

.nav{
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 24px; position:sticky; top:0; backdrop-filter:saturate(140%) blur(18px);
  background:linear-gradient(to bottom, #0e0b14cc, #0e0b1400); border-bottom:1px solid var(--border); z-index:10;
}
.brand{display:flex; align-items:center; gap:10px; font-weight:700; letter-spacing:.3px}
.brand .logo{width:28px; height:28px; color:var(--gold)}
.lang .chip{background:#ffffff10; border:1px solid var(--border); color:var(--text); padding:6px 10px; border-radius:999px; cursor:pointer}
.lang .chip.active{border-color:var(--gold); color:var(--gold)}

.hero{min-height:68vh; display:grid; place-items:center; padding:56px 20px;}
.glass{
  max-width:980px; width:100%; padding:40px; text-align:center;
  background:linear-gradient(135deg,#ffffff14,#ffffff06); border:1px solid var(--border);
  border-radius:28px; backdrop-filter:blur(22px) saturate(140%); box-shadow:0 20px 60px #00000066;
}
h1{font-size:min(10vw,64px); margin:0 0 12px; color:#f2ecff}
.lead{color:var(--muted); font-size:18px; margin:0 auto 22px; max-width:760px}
.cta{display:flex; gap:12px; justify-content:center}
.btn{background:var(--gold); color:#1a1022; border-radius:12px; padding:12px 18px; text-decoration:none; font-weight:700}
.btn.ghost{background:transparent; border:1px solid var(--border); color:var(--text)}
.section{padding:64px 20px; max-width:1100px; margin:0 auto}
.section.alt{background:linear-gradient(180deg,#180d25,#120a1b)}
h2{font-size:28px; margin:0 0 18px}
.grid{display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.card{background:#ffffff06; border:1px solid var(--border); border-radius:16px; padding:18px}
.card h3{color:var(--gold); margin:0 0 6px}

.bullets{line-height:1.8; margin:0; padding-left:18px}
.footer{border-top:1px solid var(--border); color:#cbbfdd; text-align:center; padding:24px 16px}
a{color:var(--gold)}
