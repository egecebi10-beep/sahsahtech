const apply = dict => document.querySelectorAll("[data-i18n]").forEach(el=>{
  const key = el.getAttribute("data-i18n"); if(dict[key]) el.textContent = dict[key];
});
document.getElementById("btn-en").onclick = ()=>{
  document.getElementById("btn-en").classList.add("active");
  document.getElementById("btn-tr").classList.remove("active");
  apply(en);
};
document.getElementById("btn-tr").onclick = ()=>{
  document.getElementById("btn-tr").classList.add("active");
  document.getElementById("btn-en").classList.remove("active");
  apply(tr);
};
